__pycache__/
*.pyc
build/**/*.dfu
build/**/*.bin
!build/dsp/noisegen425.bin
build/**/*.xuv
build/**/*.fs
# flash transcripts capture the device's own HW serial (bose-dfu info -f output); never commit your own
build/hook/*_flash.log
build/hook/*_readback.dfu
# assembler runs write <probe>_cmd.txt starting with the absolute path of your Python; never commit it
build/hook/*_cmd.txt
# local recordings and raw readbacks (may contain device data)
*.wav
readback_*.bin
# the docs tell you to place Bose's own firmware, its extraction, and the vendor ADK at these
# paths to rebuild anything here -- none of it may be redistributed (see NOTICE); never commit it
firmware/
adk/
build/dsp/gen.link
# never present in this export, but if you ever create one locally, never commit it either
private/
# the third-party bose-dfu.exe goes here (see docs/FLASH-PROTOCOL.md); never commit it
tools/bose-dfu/

# payload build intermediate (regenerated by build/payload/build_payload.py)
build/payload/g8/
